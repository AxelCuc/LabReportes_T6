# Database Configuration
POSTGRES_DB=your_db_name
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_PORT=5432

# Database URL for local development (outside Docker)
# DATABASE_URL=postgres://your_user:your_password@localhost:5432/your_db_name

# Database URL for Docker environment (used by web service)
DATABASE_URL=postgres://your_user:your_password@postgres_db:5432/your_db_name
